	const languageNames = {
		en: { en: "English", fr: "anglais", ko: "영어", zh: "英文" },
		fr: { en: "French", fr: "français", ko: "프랑스어", zh: "法语" },
		ko: { en: "Korean", fr: "coréen", ko: "한국어", zh: "韩语" },
		zh: { en: "Chinese", fr: "chinois", ko: "중국어", zh: "中文" },
	};
	const UI_LANGUAGE_STORAGE_KEY = "ui-language";

	function normalizeUiLanguage(lang) {
		if (!lang) return "en";
		const normalized = lang.toLowerCase();
		if (normalized.startsWith("zh")) return "zh";
		if (normalized.startsWith("fr")) return "fr";
		if (normalized.startsWith("ko")) return "ko";
		return "en";
	}

	function getBrowserLanguage() {
		const lang = navigator.language?.toLowerCase() ?? "en";
		return normalizeUiLanguage(lang);
	}

	function getStoredUiLanguage() {
		try {
			const stored = localStorage.getItem(UI_LANGUAGE_STORAGE_KEY);
			return stored ? normalizeUiLanguage(stored) : null;
		} catch {
			return null;
		}
	}

	function getUiLanguage() {
		return getStoredUiLanguage() ?? getBrowserLanguage();
	}

	function format(message, values) {
		return Object.entries(values).reduce(
			(text, [key, value]) => text.replaceAll(`{${key}}`, value),
			message,
		);
	}

	function updateUiLanguageButtons(uiLanguage) {
		document.querySelectorAll("[data-ui-language-button]").forEach((element) => {
			const isCurrent = element.dataset.languageCode === uiLanguage;
			element.setAttribute("aria-pressed", isCurrent.toString());
			element.dataset.current = isCurrent.toString();
		});
	}

	function applyUiLanguage(nextLanguage) {
		const uiLanguage = nextLanguage ? normalizeUiLanguage(nextLanguage) : getUiLanguage();
		const messages = uiMessages[uiLanguage] ?? uiMessages.en;
		document.documentElement.dataset.uiLang = uiLanguage;
		document.documentElement.lang = uiLanguage;

		document.querySelectorAll("[data-i18n]").forEach((element) => {
			const key = element.dataset.i18n;
			if (key && messages[key]) element.textContent = messages[key];
		});

		document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
			const key = element.dataset.i18nAriaLabel;
			if (!key || !messages[key]) return;
			const language = element.dataset.languageCode;
			const languageName = language ? (languageNames[language]?.[uiLanguage] ?? language) : "";
			element.setAttribute("aria-label", format(messages[key], { language: languageName }));
		});

		updateUiLanguageButtons(uiLanguage);
	}

	function bindUiLanguageButtons() {
		document.querySelectorAll("[data-ui-language-button]").forEach((element) => {
			if (element.dataset.bound === "true") return;
			element.dataset.bound = "true";
			element.addEventListener("click", () => {
				const nextLanguage = element.dataset.languageCode;
				if (!nextLanguage) return;
				try {
					localStorage.setItem(UI_LANGUAGE_STORAGE_KEY, normalizeUiLanguage(nextLanguage));
				} catch {
					// Ignore storage failures; the immediate language switch still works.
				}
				applyUiLanguage(nextLanguage);
			});
		});
	}

	applyUiLanguage();
	bindUiLanguageButtons();
	document.addEventListener("astro:page-load", () => {
		applyUiLanguage();
		bindUiLanguageButtons();
	});
</script>
