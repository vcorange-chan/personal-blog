---
import type { AcademicItem } from "@/data/publications";

interface Props {
	emptyText: string;
	items: AcademicItem[];
}

const { emptyText, items } = Astro.props;
---

{
	items.length ? (
		<ul class="space-y-4">
			{items.map((item) => (
				<li class="border-muted/30 rounded-md border p-4">
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
						<h3 class="title text-lg">{item.title}</h3>
						{item.year && <span class="text-muted text-xs">{item.year}</span>}
					</div>
					{item.authors?.length && (
						<p class="text-muted mt-2 text-sm">{item.authors.join(", ")}</p>
					)}
					{(item.status || item.venue) && (
						<p class="text-accent mt-2 text-sm font-semibold">
							{[item.status, item.venue].filter(Boolean).join(" - ")}
						</p>
					)}
					{item.description && <p class="mt-3 leading-7">{item.description}</p>}
					{!!item.links?.length && (
						<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
							{item.links.map((link) => (
								<li>
									<a class="cactus-link" href={link.url}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	) : (
		<p class="text-muted">{emptyText}</p>
	)
}
