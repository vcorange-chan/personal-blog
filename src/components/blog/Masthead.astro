---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	content: CollectionEntry<"posts">;
	readingTime: string;
}
const {
	content: { data },
	readingTime,
} = Astro.props;
const languages: Record<string, string> = {
	en: "English",
	fr: "Français",
	ko: "한국어",
	zh: "中文",
};
---

<p class="article-date">
	<FormattedDate date={data.date} dateTimeOptions={{ month: "long" }} />
	{data.draft && <span> / Draft</span>}
</p>
<h1 class:list={["article-title", { "article-title-long": data.title.length > 42 }]}>
	{data.title}
</h1>
<div class="article-byline">
	<span>Clifford Chen</span>
	<span>{readingTime}</span>
	<span>{languages[data.lang] ?? data.lang}</span>
	{
		data.updatedDate && (
			<span>
				Updated <FormattedDate date={data.updatedDate} />
			</span>
		)
	}
</div>
{
	data.tags?.length && (
		<nav class="article-tags" aria-label="Article tags">
			{data.tags.map((tag) => (
				<a href={`/tags/${tag}/`}>{tag}</a>
			))}
		</nav>
	)
}
