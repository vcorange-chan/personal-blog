---
import type { CollectionEntry, CollectionKey } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const categoryLabels: Record<string, string> = {
	academia: "Academia",
	lang: "Languages",
	math: "Mathematics",
	projects: "Projects",
	read: "Reading",
	tech: "Technology",
};

export const getStaticPaths = (async () => {
	const allPosts = await getAllPosts();
	const pairs = new Map<string, { category: string; subcategory: string }>();

	allPosts.forEach((post) => {
		const { category, subcategory } = post.data;
		if (!subcategory) return;
		pairs.set(`${category}/${subcategory}`, { category, subcategory });
	});

	return [...pairs.values()].map(({ category, subcategory }) => ({
		params: { category, subcategory },
		props: {
			category,
			posts: allPosts
				.filter((post) => post.data.category === category && post.data.subcategory === subcategory)
				.sort(collectionDateSort),
			subcategory,
		},
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, posts, subcategory } = Astro.props as Props;
const categoryTitle = categoryLabels[category] ?? category;
const groupedByYear = groupPostsByYear(posts as CollectionEntry<CollectionKey>[]);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout
	meta={{
		description: `Posts filed under ${categoryTitle} / ${subcategory}.`,
		title: `${categoryTitle}: ${subcategory}`,
	}}
>
	<nav class="mb-8" aria-label="Breadcrumbs">
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href={`/${category}/`}>{categoryTitle}</a>
				<Icon aria-hidden="true" class="mx-1.5" name="mdi:chevron-right" />
			</li>
			<li aria-current="page">{subcategory}</li>
		</ul>
	</nav>

	<h1 class="title mb-6">{subcategory}</h1>

	{
		descYearKeys.map((yearKey) => (
			<section class="mb-16">
				<h2 id={`year-${yearKey}`} class="title text-lg">
					<span class="sr-only">Posts in</span>
					{yearKey}
				</h2>
				<ul class="mt-5 space-y-4 text-start">
					{groupedByYear[yearKey]?.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		))
	}
</PageLayout>
