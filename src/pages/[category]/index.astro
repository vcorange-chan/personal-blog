---
import type { CollectionEntry, CollectionKey } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import {
	getAllPosts,
	getCategoryCounts,
	getSubcategoryCounts,
	groupPostsByYear,
} from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const categoryLabels: Record<string, string> = {
	lang: "Languages",
	math: "Mathematics",
	projects: "Projects",
	read: "Reading",
	tech: "Technology",
};

export const getStaticPaths = (async () => {
	const allPosts = await getAllPosts();
	const routeCategories = ["lang", "math", "projects", "read", "tech"];

	return routeCategories.map((category) => ({
		params: { category },
		props: {
			category,
			categoryCounts: getCategoryCounts(allPosts),
			posts: allPosts.filter((post) => post.data.category === category).sort(collectionDateSort),
			subcategoryCounts: getSubcategoryCounts(allPosts, category),
		},
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, categoryCounts, posts, subcategoryCounts } = Astro.props as Props;
const title = categoryLabels[category] ?? category;
const groupedByYear = groupPostsByYear(posts as CollectionEntry<CollectionKey>[]);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={{ description: `Posts filed under ${title}.`, title }}>
	<nav class="mb-8" aria-label="Categories">
		<ul class="flex flex-wrap gap-x-4 gap-y-2">
			{
				categoryCounts.map(([name, count]) => (
					<li>
						<a class="cactus-link" href={`/${name}/`}>
							{categoryLabels[name] ?? name}
						</a>
						<span class="text-muted ms-1">({count})</span>
					</li>
				))
			}
		</ul>
	</nav>

	<h1 class="title mb-6">{title}</h1>

	{
		!!subcategoryCounts.length && (
			<section class="mb-12">
				<h2 class="title text-accent mb-4 text-lg">Subcategories</h2>
				<ul class="flex flex-wrap gap-x-4 gap-y-2">
					{subcategoryCounts.map(([subcategory, count]) => (
						<li>
							<a class="cactus-link" href={`/${category}/${subcategory}/`}>
								{subcategory}
							</a>
							<span class="text-muted ms-1">({count})</span>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		posts.length ? (
			descYearKeys.map((yearKey) => (
				<section class="mb-16">
					<h2 id={`year-${yearKey}`} class="title text-lg">
						<span class="sr-only">Posts in</span>
						{yearKey}
					</h2>
					<ul class="mt-5 space-y-4 text-start">
						{groupedByYear[yearKey]?.map((p) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			))
		) : (
			<p class="text-muted">No posts in this category yet.</p>
		)
	}
</PageLayout>
