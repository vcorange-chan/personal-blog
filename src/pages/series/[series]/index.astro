---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getSeriesCounts, slugifyValue, sortSeriesPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const allPosts = await getAllPosts();

	return getSeriesCounts(allPosts).map(([series]) => ({
		params: { series: slugifyValue(series) },
		props: {
			posts: sortSeriesPosts(allPosts.filter((post) => post.data.series === series)),
			series,
		},
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts, series } = Astro.props as Props;
---

<PageLayout
	meta={{
		description: `All posts in the ${series} series.`,
		title: series,
	}}
>
	<nav class="mb-8" aria-label="Breadcrumbs">
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href="/series/">Series</a>
				<Icon aria-hidden="true" class="mx-1.5" name="mdi:chevron-right" />
			</li>
			<li aria-current="page">{series}</li>
		</ul>
	</nav>

	<h1 class="title mb-6">{series}</h1>
	<ol class="space-y-4">
		{
			posts.map((p) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview as="h2" post={p} />
				</li>
			))
		}
	</ol>
</PageLayout>
