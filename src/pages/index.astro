---
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getCategoryCounts, getSeriesCounts, slugifyValue } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

const categoryLabels = {
	academia: {
		description: "Research notes and academic records.",
		href: "/academia/",
		title: "Academia",
	},
	lang: {
		description: "French, Korean, English, and language study.",
		href: "/lang/",
		title: "Languages",
	},
	math: {
		description: "Algebra, foundations, and mathematical notes.",
		href: "/math/",
		title: "Mathematics",
	},
	projects: {
		description: "Build logs and experiments.",
		href: "/projects/",
		title: "Projects",
	},
	read: {
		description: "Books, papers, and long-form reading.",
		href: "/read/",
		title: "Reading",
	},
	tech: {
		description: "Software, Rust, systems, and tools.",
		href: "/tech/",
		title: "Technology",
	},
} as const;

const fixedCategories = [
	"math",
	"tech",
	"projects",
	"academia",
	"lang",
	"read",
] as (keyof typeof categoryLabels)[];
const MAX_POSTS = 3;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"posts">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);
const categoryCountMap = new Map(getCategoryCounts(allPosts));
const allSeries = getSeriesCounts(allPosts);
---

<PageLayout meta={{ title: "Home" }}>
	<section class="mb-16">
		<h1 class="title mb-5 text-3xl">Clifford Chen</h1>
		<p class="text-muted max-w-2xl text-base leading-7">
			{siteConfig.description}
		</p>
	</section>

	<section class="mb-16">
		<div class="mb-6 flex items-end justify-between gap-4">
			<h2 class="title text-xl" data-i18n="home.recent">Recent</h2>
			<a class="cactus-link text-sm" data-i18n="common.allPosts" href="/posts/">All posts</a>
		</div>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>

	<section class="mb-16">
		<h2 class="title mb-6 text-xl" data-i18n="home.explore">Explore</h2>
		<ul class="grid gap-3 sm:grid-cols-2" role="list">
			{
				fixedCategories.map((category) => {
					const item = categoryLabels[category];
					const count = categoryCountMap.get(category) ?? 0;
					return (
						<li>
							<a
								class="border-muted/30 hover:border-accent block min-h-34 rounded-md border p-4 transition-colors"
								href={item.href}
							>
								<span class="title block text-lg" data-i18n={`home.${category}.title`}>
									{item.title}
								</span>
								<span
									class="text-muted mt-2 block leading-6"
									data-i18n={`home.${category}.description`}
								>
									{item.description}
								</span>
								<span class="text-accent mt-4 block font-semibold">
									{count}{" "}
									<span data-i18n={count === 1 ? "common.post" : "common.posts"}>
										post{count === 1 ? "" : "s"}
									</span>
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<section>
		<div class="mb-6 flex items-end justify-between gap-4">
			<h2 class="title text-xl" data-i18n="common.series">Series</h2>
			<a class="cactus-link text-sm" data-i18n="common.allSeries" href="/series/">All series</a>
		</div>
		{
			allSeries.length ? (
				<ul class="flex snap-x gap-3 overflow-x-auto pb-3" role="list">
					{allSeries.map(([series, count]) => (
						<li class="min-w-60 snap-start">
							<a
								class="border-muted/30 hover:border-accent block h-full rounded-md border p-4 transition-colors"
								href={`/series/${slugifyValue(series)}/`}
							>
								<span class="title block text-lg">{series}</span>
								<span class="text-muted mt-4 block">
									{count}{" "}
									<span data-i18n={count === 1 ? "common.post" : "common.posts"}>
										post{count === 1 ? "" : "s"}
									</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="text-muted">No series yet.</p>
			)
		}
	</section>
</PageLayout>
