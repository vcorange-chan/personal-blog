---
import AcademicList from "@/components/academia/AcademicList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getSubcategoryCounts } from "@/data/post";
import { getAcademicWork } from "@/data/publications";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const subcategoryCounts = getSubcategoryCounts(allPosts, "academia");
const readingNotes = allPosts
	.filter((post) => post.data.category === "academia" && post.data.subcategory === "reviews")
	.sort(collectionDateSort);
const academicWork = await getAcademicWork();

function sectionTitle(count: number, singular: string, plural = singular) {
	return `${count} ${count === 1 ? singular : plural}`;
}
---

<PageLayout
	meta={{
		description: "Academic notes, research records, publications, and writing in progress.",
		title: "Academia",
	}}
>
	<section class="mb-14">
		<h1 class="title mb-6">Academia</h1>
		<p class="text-muted max-w-2xl leading-7">
			Academic notes, research records, publications, and writing in progress.
		</p>
	</section>

	<section class="mb-14">
		<div class="mb-6 flex items-baseline justify-between gap-4">
			<h2 class="title text-xl">Publications</h2>
			<span class="text-muted text-xs">
				{sectionTitle(academicWork.publications.length, "item")}
			</span>
		</div>
		<AcademicList emptyText="No formal publications listed yet." items={academicWork.publications} />
	</section>

	<section class="mb-14">
		<div class="mb-6 flex items-baseline justify-between gap-4">
			<h2 class="title text-xl">In Progress</h2>
			<span class="text-muted text-xs">
				{sectionTitle(academicWork.inProgress.length, "project")}
			</span>
		</div>
		<AcademicList emptyText="No active academic projects listed yet." items={academicWork.inProgress} />
	</section>

	<section class="mb-14">
		<div class="mb-6 flex items-baseline justify-between gap-4">
			<h2 class="title text-xl">Writing</h2>
			<span class="text-muted text-xs">
				{sectionTitle(academicWork.writing.length, "draft")}
			</span>
		</div>
		<AcademicList emptyText="No writing projects listed yet." items={academicWork.writing} />
	</section>

	<section class="mb-14">
		<div class="mb-6 flex items-baseline justify-between gap-4">
			<h2 class="title text-xl">Reading Notes</h2>
			<span class="text-muted text-xs">{sectionTitle(readingNotes.length, "note")}</span>
		</div>
		{
			readingNotes.length ? (
				<ul class="space-y-4">
					{readingNotes.map((post) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview as="h3" post={post} />
						</li>
					))}
				</ul>
			) : (
				<p class="text-muted">No academia reading notes yet.</p>
			)
		}
	</section>

	{
		!!subcategoryCounts.length && (
			<section>
				<h2 class="title text-accent mb-4 text-lg">Subcategories</h2>
				<ul class="flex flex-wrap gap-x-4 gap-y-2">
					{subcategoryCounts.map(([subcategory, count]) => (
						<li>
							<a class="cactus-link" href={`/academia/${subcategory}/`}>
								{subcategory}
							</a>
							<span class="text-muted ms-1">({count})</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
