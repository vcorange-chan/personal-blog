---
import type { CollectionEntry, CollectionKey } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getSubcategoryCounts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const academiaPosts = allPosts
	.filter((post) => post.data.category === "academia")
	.sort(collectionDateSort);
const subcategoryCounts = getSubcategoryCounts(allPosts, "academia");
const groupedByYear = groupPostsByYear(academiaPosts as CollectionEntry<CollectionKey>[]);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout
	meta={{
		description: "Academic notes, research records, and study materials.",
		title: "Academia",
	}}
>
	<h1 class="title mb-6">Academia</h1>
	<p class="mb-10 text-muted">Academic notes, research records, and study materials.</p>

	{
		!!subcategoryCounts.length && (
			<section class="mb-12">
				<h2 class="title text-accent mb-4 text-lg">Subcategories</h2>
				<ul class="flex flex-wrap gap-x-4 gap-y-2">
					{subcategoryCounts.map(([subcategory, count]) => (
						<li>
							<a class="cactus-link" href={`/academia/${subcategory}/`}>
								{subcategory}
							</a>
							<span class="text-muted ms-1">({count})</span>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		academiaPosts.length ? (
			descYearKeys.map((yearKey) => (
				<section class="mb-16">
					<h2 id={`year-${yearKey}`} class="title text-lg">
						<span class="sr-only">Posts in</span>
						{yearKey}
					</h2>
					<ul class="mt-5 space-y-4 text-start">
						{groupedByYear[yearKey]?.map((p) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			))
		) : (
			<p class="text-muted">No academia posts yet.</p>
		)
	}
</PageLayout>
